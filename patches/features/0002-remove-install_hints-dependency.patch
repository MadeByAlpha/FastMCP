From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alpha <dev@alpha93.kr>
Date: Sat, 17 Oct 2026 17:13:13 +0900
Subject: [PATCH] remove install_hints dependency

Signed-off-by: Alpha <dev@alpha93.kr>

diff --git a/fastmcp_slim/fastmcp/__init__.py b/fastmcp_slim/fastmcp/__init__.py
index 72039a3e..d39b26f2 100644
--- a/fastmcp_slim/fastmcp/__init__.py
+++ b/fastmcp_slim/fastmcp/__init__.py
@@ -3,7 +3,6 @@
 import importlib
 import warnings
 
-from fastmcp import _install_hints
 from fastmcp._warnings import FastMCPDeprecationWarning
 from fastmcp.settings import Settings
 from fastmcp.utilities.logging import configure_logging as _configure_logging
@@ -41,29 +40,17 @@ if settings.deprecation_warnings:
 
 def __getattr__(name: str) -> object:
     if name == "Context":
-        try:
-            from fastmcp.server.context import Context
-        except ImportError as exc:
-            raise ImportError(_install_hints.SERVER_SUPPORT) from exc
+        from fastmcp.server.context import Context
 
         return Context
     if name == "FastMCP":
-        try:
-            from fastmcp.server.server import FastMCP
-        except ImportError as exc:
-            raise ImportError(_install_hints.SERVER_SUPPORT) from exc
+        from fastmcp.server.server import FastMCP
 
         return FastMCP
     if name == "FastMCPApp":
-        try:
-            from fastmcp.apps.app import FastMCPApp
-        except ImportError as exc:
-            raise ImportError(_install_hints.APP_SUPPORT) from exc
+        from fastmcp.apps.app import FastMCPApp
 
         return FastMCPApp
     if name == "server":
-        try:
-            return importlib.import_module("fastmcp.server")
-        except ImportError as exc:
-            raise ImportError(_install_hints.SERVER_SUPPORT) from exc
+        return importlib.import_module("fastmcp.server")
     raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
